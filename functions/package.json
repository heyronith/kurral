{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test:agents": "npm run build && node lib/scripts/test-all-agents.js",
    "test:agents:watch": "tsc --watch --project tsconfig.json",
    "test:value-scoring": "npm run build && node lib/scripts/test-value-scoring-e2e.js",
    "reset-bot-passwords": "npm run build && node lib/scripts/reset-bot-passwords-admin.js",
    "recreate-bots-except-news": "npm run build && node lib/scripts/recreate-bots-except-news-admin.js",
    "test:news-poll": "npm run build && node lib/scripts/test-news-poll.js",
    "test:review-flow": "npm run build && node lib/scripts/testReviewFlow.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/src/index.js",
  "dependencies": {
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^4.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.5.0",
    "openai": "^6.9.1",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.2.2"
  },
  "private": true
}